# CC-GLM-BRIDGE — Claude Code ↔ GLM-5.2 (z.ai) 配置模板
# 运行配置落地路径：~/.cc-bridge/glm.env（本模板首次使用时由框架自动复制到此处）
# ============================================================================
# 这是 GLM 上游（cc-glm-bridge）的配置模板。首次运行 `cc-bridge glm config`（或任何
# 需要配置的 glm 命令）时，桥会自动把本模板复制为 ~/.cc-bridge/glm.env，CLI 从任意
# 目录都能找到。每个上游一个独立配置文件（~/.cc-bridge/<upstream>.env），互不干扰；
# 多个上游想同时跑 daemon 时，各用不同的 PROXY_PORT。
#
#   API_BASE     : z.ai Coding Plan 接口地址（所有 KEY 共用同一个 URL）。
#   API_KEY_n    : z.ai 的 API KEY，每个写成独立编号变量：API_KEY_1、API_KEY_2 …（推荐
#                  至少 2 个用于容灾）。某个 KEY 被判失效 / 欠费（返回 401/403），或同 KEY
#                  瞬态重试用尽时，桥自动切换下一个 KEY 重试——URL 不变，只换 KEY。每个 KEY
#                  独立成行，方便上方注释标注账号来源、或整行注释掉临时禁用某 KEY。旧式
#                  API_KEY=k1,k2（逗号分隔）仍向后兼容，可与编号变量混用。
#   MODEL_MAP    : 模型映射，格式「spoofA->targetA,spoofB->targetB」。左侧是 Claude
#                  白名单内的模型 ID（Claude Code 看到/发送的就是它，从而让 /effort
#                  max / xhigh 通过客户端闸门），右侧是 z.ai 识别的真实模型名。桥在
#                  转发前把 body.model 从左侧改写成右侧，上游永远看不到 spoof 值。
#                  支持多对：Claude Code 用 opus 做主力、haiku 做轻量任务，所以下面
#                  两对都指向 glm-5.2。第一对是「主力对」，决定 `cc-bridge glm claude`
#                  启动 claude 时用的默认模型。整个 MODEL_MAP 不写则用 adapter 默认
#                  单对 claude-opus-4-8 → glm-5.2。
#                  旧式单对写法 SPOOF_MODEL / TARGET_MODEL 仍向后兼容（等价于一对）。
#   PROXY_PORT   : 本地监听端口（多上游并存时各用不同端口）。
#   PROXY_LOG    : 1 = 记录每条请求（默认），0 = 静默。
#
# 注：GLM-5.2 始终以 max 思考等级运行——由 glm-bridge adapter 强制（forceMaxEffort），
# 无需在此配置，也不受 Claude Code 的 /effort 档位影响。
# ============================================================================

# --- GLM 上游（z.ai GLM-5.2）---
API_BASE=https://api.z.ai/api/anthropic
# 两个 z.ai Coding Plan 的 KEY，每个独占一行（推荐）；一个不通自动切另一个。
# 在上方写注释标注账号来源；想临时停用某个 KEY，直接整行注释掉即可。
# 账号 A 的 KEY
API_KEY_1=your_zai_key_1
# 账号 B 的 KEY
API_KEY_2=your_zai_key_2
# 想加更多账号照此续写：API_KEY_3=…、API_KEY_4=…

# 模型映射（多对）：opus 做主力、haiku 做轻量任务，两对都指向 glm-5.2。
# 第一对 claude-opus-4-8 是主力对（claude 启动默认模型）。
MODEL_MAP=claude-opus-4-8->glm-5.2,claude-haiku-4-5->glm-5.2

PROXY_PORT=8788
PROXY_LOG=1
