# CC-BRIDGE — Claude Code ↔ GLM-5.2 (z.ai) 配置模板
# ============================================================================
# 这是 GLM 上游的配置模板。安装后复制到 ~/.cc-bridge/glm.env（CLI 从任意目录都能
# 找到）。每个上游一个独立配置文件（~/.cc-bridge/<upstream>.env），互不干扰；多个
# 上游想同时跑 daemon 时，各用不同的 PROXY_PORT。
#
#   API_BASE     : z.ai Coding Plan 接口地址（所有 KEY 共用同一个 URL）。
#   API_KEY      : z.ai 的 API KEY，逗号分隔可配多个（推荐至少 2 个）。当某个
#                  KEY 被判失效 / 欠费（返回 401/403），或同 KEY 瞬态重试用尽，
#                  桥会自动切换到下一个 KEY 重试——URL 不变，只换 KEY。
#   TARGET_MODEL : z.ai 识别的真实模型名（写入 body.model）。留空则用 adapter
#                  默认值 glm-5.2。
#   SPOOF_MODEL  : Claude 白名单内的模型 ID，Claude Code 看到的是它，从而让
#                  /effort max / xhigh 通过客户端闸门。桥在转发前会把 body.model
#                  改回 TARGET_MODEL，上游永远看不到 spoof 值。留空则用 adapter
#                  默认值 claude-opus-4-8。
#   CONTEXT_WINDOW    : 真实模型输入上下文窗口（token 数）。注入 API 响应的
#                       modelUsage，webview 据此显示正确用量。设为 0 则不注入。
#   MAX_OUTPUT_TOKENS : 最大输出 token 数。设为 0 则不注入。
#   PROXY_PORT   : 本地监听端口（多上游并存时各用不同端口）。
#   PROXY_LOG    : 1 = 记录每条请求（默认），0 = 静默。
#
# 注：GLM-5.2 始终以 max 思考等级运行——由 glm-bridge adapter 强制（forceMaxEffort），
# 无需在此配置，也不受 Claude Code 的 /effort 档位影响。
# ============================================================================

# --- GLM 上游（z.ai GLM-5.2）---
API_BASE=https://api.z.ai
# 两个 z.ai Coding Plan 的 KEY，逗号分隔；一个不通自动切另一个。
API_KEY=your_zai_key_1,your_zai_key_2
TARGET_MODEL=glm-5.2
SPOOF_MODEL=claude-opus-4-8

# GLM-5.2 上下文 / 输出上限（按你的 Coding Plan 实际窗口调整；设 0 则不注入）。
CONTEXT_WINDOW=1048576
MAX_OUTPUT_TOKENS=131072

PROXY_PORT=8787
PROXY_LOG=1
