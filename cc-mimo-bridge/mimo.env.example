# CC-MIMO-BRIDGE — Claude Code ↔ MiMo（小米）配置模板
# 运行配置落地路径：~/.cc-bridge/mimo.env（本模板首次使用时由框架自动复制到此处）
# ============================================================================
# 这是 MiMo 上游（cc-mimo-bridge）的配置模板。首次运行 `cc-bridge mimo config`（或任何
# 需要配置的 mimo 命令）时，桥会自动把本模板复制为 ~/.cc-bridge/mimo.env，CLI 从任意
# 目录都能找到。每个上游一个独立配置文件（~/.cc-bridge/<upstream>.env），互不干扰；
# 多个上游想同时跑 daemon 时，各用不同的 PROXY_PORT。
#
#   API_BASE     : MiMo Anthropic 兼容接口地址（所有 KEY 共用同一个 URL）。
#   API_KEY_n    : MiMo 的 API KEY，每个写成独立编号变量：API_KEY_1、API_KEY_2 …（推荐
#                  至少 2 个用于容灾）。某个 KEY 被判失效 / 欠费（返回 401/403），或同 KEY
#                  瞬态重试用尽时，桥自动切换下一个 KEY 重试——URL 不变，只换 KEY。每个 KEY
#                  独立成行，方便上方注释标注账号来源、或整行注释掉临时禁用某 KEY。旧式
#                  API_KEY=k1,k2（逗号分隔）仍向后兼容。
#   MODEL_MAP    : 模型映射，格式「spoofA->targetA,spoofB->targetB」。左侧是 Claude
#                  白名单内的模型 ID，右侧是 MiMo 识别的真实模型名。桥在
#                  转发前把 body.model 从左侧改写成右侧，上游永远看不到 spoof 值。
#                  支持多对：整个 MODEL_MAP 不写则用 adapter 默认
#                  单对 claude-opus-4-8 → mimo-v2.5-pro。
#               
#   PROXY_PORT   : 本地监听端口（多上游并存时各用不同端口）。
#   PROXY_LOG    : 1 = 记录每条请求（默认），0 = 静默。
#   PROXY_DUMP   : 1 = 把每个改写后的请求体落盘到 ~/.cc-bridge/dumps/（默认 0 关，调试用）。
#
# 注：MiMo 官方 API 的思考模式只有两种状态（见官方文档）：
#   enabled  → 开启深度思考
#   disabled → 关闭深度思考
# 不支持中间等级（如 high/medium/low）。每个模型的思考开关由下方 MODEL_THINKING 控制，
# 按 target 模型钉死、忽略 Claude Code 的 /effort 档位；
# 未列出的模型走 MODEL_THINKING_DEFAULT（默认 enabled）。
# ============================================================================

# --- MiMo 上游（小米）---
API_BASE=https://token-plan-cn.xiaomimimo.com/anthropic/endpoint
# 两个 MiMo 的 KEY，每个独占一行（推荐）；一个不通自动切另一个。
# 在上方写注释标注账号来源；想临时停用某个 KEY，直接整行注释掉即可。
# 账号 A 的 KEY
API_KEY_1=your_mimo_key_1
# 账号 B 的 KEY
API_KEY_2=your_mimo_key_2
# 想加更多账号照此续写：API_KEY_3=…、API_KEY_4=…

# 模型映射（多对）
MODEL_MAP=claude-opus-4-8->mimo-v2.5-pro,claude-haiku-4-5->mimo-v2.5,claude-sonnet-5->mimo-v2.5

# 按模型思考开关（target 模型 -> 开关）：每个真实模型钉死思考开关，忽略 Claude Code
# 的 /effort 档位。取值：enabled（开启深度思考）/ disabled（关闭深度思考）。
# 未列出的模型用 MODEL_THINKING_DEFAULT（默认 enabled）。
# 示例：mimo-v2.5 关闭思考、其余开启。
MODEL_THINKING=mimo-v2.5->disabled
MODEL_THINKING_DEFAULT=enabled

PROXY_PORT=8791
PROXY_LOG=1

# 调试用：PROXY_DUMP=1 会把每个改写后的请求体落盘到 ~/.cc-bridge/dumps/（用于验证适配
# 是否生效）。平时别开——每个请求同步写一个文件且不轮转，会拖慢转发、撑爆磁盘；排查完
# 务必改回并清空 dumps 目录。
# PROXY_DUMP=0

# --- CC 安全分类器路由（CC auto mode 的 security-monitor 请求）---
# CC auto 模式下，主 agent 每次工具调用前都会发一个请求给安全分类器判断该动作是否该 block。
# 它高频（约是主对话请求数的 3 倍）且默认用 opus 倍率，是 MiMo 额度消耗的大头。
# 这里控制分类器请求怎么处理：
#   on  = 走下方 AGNES 免费模型判断（agnes-2.5-flash / agnes-2.0-flash，当前 $0/1M 免费促销）；
#         主模型请求失败立即切备用模型。需配 AGNES_API_KEY。
#   off = 桥直接伪造 <block>no</block> 放行响应，不走任何模型（0 消耗，但无安全判断——所有动作放行）。
# 未配置时默认 off。
CLASSIFIER_MODE=off
AGNES_API_BASE=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_API_KEY=your_agnes_api_key
AGNES_MODEL_PRIMARY=agnes-2.5-flash
AGNES_MODEL_FALLBACK=agnes-2.0-flash
